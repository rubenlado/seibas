---
import { ArrowRight } from '@lucide/astro';
interface Props { slug: string; title: string; short: string; color: string; }
const { slug, title, short, color } = Astro.props;
---
<article class={`service-card service-card--${color}`}>
  <h3><a href={`/servizos/${slug}/`}>{title}</a></h3>
  <p>{short}</p>
  <a class="text-link" href={`/servizos/${slug}/`} aria-label={`Coñecer ${title}`}>Coñecer o servizo <ArrowRight size={16} stroke-width={1.75} aria-hidden="true" /></a>
</article>

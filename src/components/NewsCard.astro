---
import { ArrowRight } from '@lucide/astro';
import { withBase } from '../utils/paths';
interface Props {
  slug: string;
  category: string;
  title: string;
  excerpt: string;
  image: string;
  imageAlt: string;
  color: string;
}
const { slug, category, title, excerpt, image, imageAlt, color } = Astro.props;
const fallback = image.replace('.webp', '.jpg');
const href = withBase(`/novas/${slug}/`);
---
<article class={`news-card news-card--${color}`}>
  <a class="news-card-image" href={href} tabindex="-1" aria-hidden="true">
    <picture>
      <source srcset={withBase(`/assets/images/${image}`)} type="image/webp" />
      <img src={withBase(`/assets/images/${fallback}`)} alt={imageAlt} width="800" height="800" loading="lazy" />
    </picture>
  </a>
  <div class="news-card-body">
    <h3><a href={href}>{title}</a></h3>
    <p class="news-category">{category}</p>
    <p>{excerpt}</p>
    <a class="text-link" href={href}>Ler a nova <ArrowRight size={16} stroke-width={1.75} aria-hidden="true" /></a>
  </div>
</article>

---
import { navigation } from '../data/site';
import { Menu, X } from '@lucide/astro';
const path = Astro.url.pathname;
const isCurrent = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="header-inner shell">
    <a class="brand" href="/" aria-label="As Seibas, inicio">
      <img src="/assets/logo.png" width="300" height="169" alt="As Seibas Espazo Educativo" />
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Abrir menú">
      <Menu class="menu-icon menu-icon--open" size={24} stroke-width={1.75} aria-hidden="true" />
      <X class="menu-icon menu-icon--close" size={24} stroke-width={1.75} aria-hidden="true" />
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Navegación principal">
      {navigation.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="nav-contact" href="/contacto/">Contacto</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#site-nav');
  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Abrir menú' : 'Pechar menú');
    nav?.classList.toggle('is-open', !isOpen);
  });
</script>
